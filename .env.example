# ================== backend/.env ==================
# PROD uchun namuna. `DEBUG=False`, kuchli `SECRET_KEY`, domen origin'lari.

# --- Django ---------------------------------------------------------------
SECRET_KEY=CHANGE-ME-with-a-long-random-string
DEBUG=False
# Domeningiz + (xohlasangiz) IP. Cloudflare ortida domen yetarli.
ALLOWED_HOSTS=listening.uz,www.listening.uz

# Admin/login HTTPS'da CSRF xatosiz ishlashi uchun SHART (sxema bilan):
EXTRA_ORIGINS=https://listening.uz,https://www.listening.uz

# --- Baza / navbat (docker compose o'zi to'ldiradi, bo'sh qoldiring) ------
# docker-compose web servisi DATABASE_URL va REDIS_URL ni environment'da beradi.
DATABASE_URL=
REDIS_URL=

# --- Telegram bot ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_BOT_USERNAME=elistening_bot

# --- Sayt manzili (bot xabarlari, limit havolasi shu domendan) ------------
SITE_URL=https://listening.uz

# --- AI kalitlari ---------------------------------------------------------
GPT_API_KEY=sk-...
CLAUDE_API_KEY=sk-ant-...

# --- Kontent o'rami (frontend VITE_CONTENT_SECRET bilan AYNAN bir xil) -----
CONTENT_SECRET=CHANGE-ME-content-secret
PROTECT_CONTENT=True

# --- hCaptcha (login captcha) ---------------------------------------------
# hCaptcha dashboard'dan (https://dashboard.hcaptcha.com) olinadi.
# SECRET bo'sh bo'lsa captcha O'CHIQ. SITEKEY frontend build'ida ham kerak.
HCAPTCHA_SECRET=
HCAPTCHA_SITEKEY=

# TLS to'liq HTTPS bo'lgach (Cloudflare Full/strict) xohlasangiz True qiling.
# Cloudflare Flexible'da False qoldiring (aks holda redirect halqasi bo'lishi mumkin).
SECURE_SSL_REDIRECT=False
