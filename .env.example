# ================== backend/.env ==================
# PROD uchun namuna. `DEBUG=False`, kuchli `SECRET_KEY`, domen origin'lari.

# --- Django ---------------------------------------------------------------
# MAJBURIY, kamida 50 belgi — u JWT'ni ham imzolaydi (qisqa kalit = tokenni
# brute-force qilib, istalgan foydalanuvchi nomidan token yasash mumkin).
# Prod sozlamalari qisqa kalit bilan ishga TUSHMAYDI. Yasash:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=CHANGE-ME-with-a-long-random-string
DEBUG=False
# Domeningiz + (xohlasangiz) IP. Cloudflare ortida domen yetarli.
ALLOWED_HOSTS=listening.uz,www.listening.uz

# Admin/login HTTPS'da CSRF xatosiz ishlashi uchun SHART (sxema bilan):
EXTRA_ORIGINS=https://listening.uz,https://www.listening.uz

# --- Baza / navbat (docker compose o'zi to'ldiradi, bo'sh qoldiring) ------
# docker-compose web servisi DATABASE_URL va REDIS_URL ni environment'da beradi.
DATABASE_URL=
REDIS_URL=

# --- Telegram bot ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_BOT_USERNAME=elistening_bot

# --- Sayt manzili (bot xabarlari, limit havolasi shu domendan) ------------
SITE_URL=https://listening.uz

# --- AI kalitlari ---------------------------------------------------------
GPT_API_KEY=sk-...
CLAUDE_API_KEY=sk-ant-...

# --- Kontent o'rami (frontend VITE_CONTENT_SECRET bilan AYNAN bir xil) -----
CONTENT_SECRET=CHANGE-ME-content-secret
PROTECT_CONTENT=True

# --- hCaptcha (login captcha) ---------------------------------------------
# hCaptcha dashboard'dan (https://dashboard.hcaptcha.com) olinadi.
# SECRET bo'sh bo'lsa captcha O'CHIQ. SITEKEY frontend build'ida ham kerak.
HCAPTCHA_SECRET=
HCAPTCHA_SITEKEY=

# TLS to'liq HTTPS bo'lgach (Cloudflare Full/strict) xohlasangiz True qiling.
# Cloudflare Flexible'da False qoldiring (aks holda redirect halqasi bo'lishi mumkin).
SECURE_SSL_REDIRECT=False

# --- Paynet (to'lov tizimi) -----------------------------------------------
# DIQQAT: bu tashqi API kaliti EMAS. Paynet BIZGA murojaat qiladi, shu bois
# bu yerda Paynet kiradigan login/parol turadi. Qiymatlarni Paynet shartnoma
# ilovasidagi "Таблица 1" da beradi.
PAYNET_LOGIN=
PAYNET_PASSWORD=
# Paynet bergan servis ID(lar)i, vergul bilan. PROD'DA TO'LDIRILISHI SHART —
# bo'sh qoldirilsa har qanday serviceId qabul qilinadi.
PAYNET_SERVICE_IDS=
PAYNET_SERVICE_NAME=listening.uz
# Приложение №2, 4.2-band. Odatda o'zgartirilmaydi. Bo'sh qoldirilsa
# (DEBUG=False bo'lganda) HECH KIM kira olmaydi — ataylab shunday.
PAYNET_ALLOWED_NETS=213.230.106.112/28,213.230.65.80/28
# To'lovda identifikator maydonining nomi (= Telegram chat ID).
PAYNET_CLIENT_FIELD=client_id
# Summa chegaralari TIYINDA: 100000 = 1 000 so'm, 100000000 = 1 000 000 so'm.
PAYNET_MIN_AMOUNT_TIYIN=100000
PAYNET_MAX_AMOUNT_TIYIN=100000000

# --- Click (SHOP-API + to'lov havolasi) -----------------------------------
# Paynet'dan FARQLI: Click redirect'li checkout. Qiymatlar merchant.click.uz
# kabinetidan olinadi ("Сервисы" bo'limi).
# "Сервисы" jadvalidagi `Service ID` ustuni.
CLICK_SERVICE_ID=
# Imzo kaliti — BU INTEGRATSIYANING YAGONA XAVFSIZLIK CHEGARASI.
# "Сервисы" jadvalidagi `Секретный ключ (СК)`.
# Bo'sh bo'lsa hech qanday Click so'rovi qabul qilinmaydi (ataylab shunday).
CLICK_SECRET_KEY=
# IXTIYORIY — kabinetda bunday maydon yo'q va Click'ning o'z kutubxonasi ham
# uni ishlatmaydi. Bo'sh bo'lsa to'lov havolasiga qo'shilmaydi.
CLICK_MERCHANT_ID=
# Merchant API (invoys/reversal) uchun — hozircha ishlatilmaydi.
CLICK_MERCHANT_USER_ID=
# Odatda o'zgartirilmaydi.
CLICK_PAY_URL=https://my.click.uz/services/pay
# To'lovdan keyin foydalanuvchi qaytadigan sahifa (bo'sh = SITE_URL/profile/billing)
CLICK_RETURN_URL=
